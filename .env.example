APP_NAME="Anare Clinic"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Optional: tokens for automatic refresh; fetched public thumbnails are cached.
# INSTAGRAM_ACCESS_TOKEN remains a legacy alias for the Clinic account.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ANARECLINIC_ACCESS_TOKEN=
INSTAGRAM_ANARESHAPE_ACCESS_TOKEN=
INSTAGRAM_API_VERSION=v22.0

# Optional: Google Places API (New), used only on the server for review refresh.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=ChIJfTCB-Mv71y0RBeDF30u7ey8
