# Installed at /home/anaj8418/public_html/.htaccess.
# Anare Clinic production (Laravel). Former WordPress files are archived outside public_html.
Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Canonical https://anare.co.id; ACME validation stays reachable.
RewriteCond %{HTTP_HOST} ^(www\.)?anare\.co\.id$ [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://anare.co.id%{REQUEST_URI} [R=301,L]

# Drop trailing slashes before the internal rewrite so Laravel never exposes the release path.
RewriteCond %{HTTP_HOST} ^anare\.co\.id$ [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteRule ^ https://anare.co.id%1 [R=301,L]

# A directory-index request for the release root returns 405 on this host; route "/" to the front controller.
RewriteCond %{HTTP_HOST} ^anare\.co\.id$ [NC]
RewriteRule ^$ /anare-prod/public/index.php [L]

RewriteCond %{HTTP_HOST} ^anare\.co\.id$ [NC]
RewriteCond %{REQUEST_URI} !^/anare-prod/
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^(.*)$ /anare-prod/public/$1 [L]
</IfModule>
# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php84” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
